{
  "name": "product-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "Read-optimized REST backend for an e-commerce product catalog",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "explain": "tsx scripts/explain.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "fastify": "^5.12.8",
    "lru-cache": "^11.5.3",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
